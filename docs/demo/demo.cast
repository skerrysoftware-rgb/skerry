[0.030, "o", "\u001b[?25l\u001b[2;1H     \u001b[37m\u001b[2m 1 \u001b(B\u001b[m\u001b[37m \u001b[90m// Places an order and runs its fulfilment workflow on Temporal.\u001b[39m\u001b[27X\u001b[92m\r\n      2 +\u001b[96mconst\u001b(B\u001b[m\u001b[37m { parseArgs } = \u001b[96mrequire\u001b(B\u001b[m\u001b[37m(\u001b[92m'util'\u001b(B\u001b[m\u001b[37m);\u001b[39m\u001b[53X\r\n     \u001b[37m\u001b[2m 3 \u001b(B\u001b[m\u001b[37m \u001b[96mconst\u001b(B\u001b[m\u001b[37m { \u001b[93mClient\u001b(B\u001b[m\u001b[37m, \u001b[93mConnection\u001b(B\u001b[m\u001b[37m } = \u001b[96mrequire\u001b(B\u001b[m\u001b[37m(\u001b[92m'@temporalio/client'\u001b(B\u001b[m\u001b[37m);\u001b[39m\u001b[30X\r\n     \u001b[37m\u001b[2m 4 \u001b(B\u001b[m\u001b[37m \u001b[96mconst\u001b(B\u001b[m\u001b[37m { \u001b[93mWorker\u001b(B\u001b[m\u001b[37m, \u001b[93mNativeConnection\u001b(B\u001b[m\u001b[37m, \u001b[93mRuntime\u001b(B\u001b[m\u001b[37m, \u001b[93mDefaultLogger\u001b(B\u001b[m\u001b[37m } = \u001b[96mrequire\u001b(B\u001b[m\u001b[37m(\u001b[92m'@temporalio/wo\u001b[39m       \r\n     \u001b[37m\u001b[2m   \u001b(B\u001b[m\u001b[37m \u001b[92mrker'\u001b(B\u001b[m\u001b[37m);\u001b[39m\u001b[84X\r\n     \u001b[37m\u001b[2m 5 \u001b(B\u001b[m\u001b[37m \u001b[96mconst\u001b(B\u001b[m\u001b[37m activities = \u001b[96mrequire\u001b(B\u001b[m\u001b[37m(\u001b[92m'./activities'\u001b(B\u001b[m\u001b[37m);\u001b[39m\u001b[48X\r\n     \u001b[37m\u001b[2m...\u001b(B\u001b[m\u001b[92X\r\n     \u001b[37m\u001b[2m  7 \u001b(B\u001b[m\u001b[37m \u001b[93mRuntime\u001b(B\u001b[m\u001b[37m.\u001b[93minstall\u001b(B\u001b[m\u001b[37m({ logger: \u001b[95mnew\u001b(B\u001b[m\u001b[37m \u001b[93mDefaultLogger\u001b(B\u001b[m\u001b[37m(\u001b[92m'ERROR'\u001b(B\u001b"]
